# Copy to docker/.env and fill in absolute host paths for your machine.

# Folder containing your photo library (mounted read-write, since Step 4
# writes XMP sidecars / embeds XMP into files here).
IMAGES_ROOT_HOST=D:/photos

# Folder containing a COPY of your Lightroom catalog (not the live .lrcat
# Lightroom has open). Only the folder is mounted, so the catalog file can be
# refreshed by re-copying it without touching docker-compose.
CATALOG_COPY_DIR_HOST=D:/lightroom/catalog_copy
